<section class="block wrap">
  <div class="section-head"><div><span class="eyebrow">Journal</span><h2>{{ blog.title }}</h2><div class="scan-line"></div></div></div>
  <div class="product-grid">
    {%- for article in blog.articles -%}
      <a class="card" href="{{ article.url }}" style="text-decoration:none"><div class="card-body"><h3 class="card-name">{{ article.title }}</h3><p class="sub">{{ article.published_at | date: '%d %b %Y' }}</p></div></a>
    {%- endfor -%}
  </div>
</section>
