{%- comment -%}
  Flat product illustration per kind, used as card media when no photo
  is supplied. Usage: {% render 'clima-illustration', kind: 'split', color: '#3aa6e0' %}
{%- endcomment -%}
{%- assign c = color | default: '#3aa6e0' -%}
{%- case kind -%}
  {%- when 'split' -%}
    <svg viewBox="0 0 240 150" class="card-illu">
      <rect x="20" y="40" width="200" height="58" rx="14" fill="#fff" stroke="#1c2226" stroke-width="2"/>
      <rect x="28" y="84" width="184" height="8" rx="4" fill="{{ c }}"/>
      <g stroke="#9fb4c2" stroke-width="2"><path d="M34 54h172M34 62h172M34 70h172"/></g>
      <rect x="170" y="50" width="34" height="12" rx="3" fill="#eef5fb" stroke="#9fb4c2"/>
      <g stroke="{{ c }}" stroke-width="2.5" stroke-linecap="round" opacity=".7"><path d="M70 112c8-6 8-10 0-16M120 112c8-6 8-10 0-16M170 112c8-6 8-10 0-16"/></g>
    </svg>
  {%- when 'portable' -%}
    <svg viewBox="0 0 240 150" class="card-illu">
      <rect x="86" y="14" width="68" height="124" rx="14" fill="#fff" stroke="#1c2226" stroke-width="2"/>
      <rect x="96" y="24" width="48" height="34" rx="6" fill="{{ c }}"/>
      <g stroke="#9fb4c2" stroke-width="2"><path d="M96 74h48M96 84h48M96 94h48M96 104h48"/></g>
      <path d="M154 40c30 0 34 18 34 40" fill="none" stroke="#9fb4c2" stroke-width="6" stroke-linecap="round" opacity=".7"/>
    </svg>
  {%- when 'ventilation' -%}
    <svg viewBox="0 0 240 150" class="card-illu">
      <rect x="70" y="15" width="100" height="120" rx="16" fill="#fff" stroke="#1c2226" stroke-width="2"/>
      <g fill="none" stroke="{{ c }}" stroke-width="4"><circle cx="120" cy="75" r="10"/><circle cx="120" cy="75" r="24"/><circle cx="120" cy="75" r="38"/></g>
      <circle cx="120" cy="75" r="5" fill="{{ c }}"/>
    </svg>
  {%- when 'fan-ceiling' -%}
    <svg viewBox="0 0 240 150" class="card-illu">
      <g transform="translate(120 75)">
        <g fill="{{ c }}"><rect x="-9" y="-58" width="18" height="48" rx="8"/><rect x="-9" y="10" width="18" height="48" rx="8"/><rect x="10" y="-9" width="48" height="18" rx="8"/><rect x="-58" y="-9" width="48" height="18" rx="8"/></g>
        <circle r="15" fill="#1c2226"/><circle r="6" fill="#fff"/>
      </g>
    </svg>
  {%- else -%}
    <svg viewBox="0 0 240 150" class="card-illu">
      <g fill="none" stroke="{{ c }}" stroke-width="3"><circle cx="120" cy="58" r="14"/><circle cx="120" cy="58" r="28"/><circle cx="120" cy="58" r="42"/></g>
      <circle cx="120" cy="58" r="7" fill="{{ c }}"/>
      <path d="M120 100v34" stroke="#1c2226" stroke-width="4" stroke-linecap="round"/>
      <path d="M102 138h36" stroke="#1c2226" stroke-width="4" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
