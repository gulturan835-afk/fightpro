<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ shop.name }}</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  {{ 'clima.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <main class="wrap" style="min-height:80vh;display:grid;place-items:center;text-align:center">
    <div>
      <span class="eyebrow">Opening soon</span>
      <h1 style="font-size:2.4rem;margin:.6rem 0">{{ shop.name }}</h1>
      {{ content_for_layout }}
    </div>
  </main>
</body>
</html>
