<section class="block wrap" id="{{ section.settings.anchor | default: 'reviews' }}">
  <div class="section-head">
    <div>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
      <div class="scan-line"></div>
    </div>
    <p class="sub">{{ section.settings.subtitle }}</p>
  </div>
  <div class="review-grid">
    {%- for block in section.blocks -%}
      {%- assign stars = block.settings.stars | default: 5 -%}
      <div class="review reveal" {{ block.shopify_attributes }}>
        <div class="stars">
          {%- for i in (1..5) -%}{%- if i <= stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
        </div>
        <p>"{{ block.settings.text }}"</p>
        <div class="who"><b>{{ block.settings.name }} · {{ block.settings.place }}</b><span>{{ block.settings.product }} · {{ block.settings.date }}</span></div>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor id", "default": "reviews" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verified checkout reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Customer Reviews" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "★ 4.9 / 5 average across 1.240+ installations." }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text", "default": "Great product and silent operation." },
        { "type": "text", "id": "name", "label": "Name", "default": "Marloes V." },
        { "type": "text", "id": "place", "label": "Place", "default": "Enschede" },
        { "type": "text", "id": "product", "label": "Product", "default": "ArcticPro 3.5kW" },
        { "type": "text", "id": "date", "label": "Date", "default": "2026-05-18" }
      ]
    }
  ],
  "presets": [ { "name": "Reviews" } ]
}
{% endschema %}
