<div class="ticker" aria-hidden="true">
  <div class="ticker-in">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="t-item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span><span class="t-dot"></span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Ticker",
  "blocks": [
    {
      "type": "item",
      "name": "Tekst",
      "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Handschoenen passen in de winkel" } ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "text": "Handschoenen passen in de winkel" } },
      { "type": "item", "settings": { "text": "Officiële groothandel" } },
      { "type": "item", "settings": { "text": "Joya · Hayabusa · Twins · Booster · Fairtex" } },
      { "type": "item", "settings": { "text": "Deskundig advies van actieve sporters" } },
      { "type": "item", "settings": { "text": "Lipperkerkstraat 19 Enschede" } },
      { "type": "item", "settings": { "text": "25 topmerken onder één dak" } }
    ]
  },
  "presets": [ { "name": "Ticker" } ]
}
{% endschema %}
