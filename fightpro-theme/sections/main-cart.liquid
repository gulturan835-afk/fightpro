{%- assign threshold = settings.free_shipping_threshold | default: 7500 | times: 1 -%}
<div class="shop-head">
  <div class="container">
    <nav class="crumb" aria-label="Kruimelpad">
      <a href="{{ routes.root_url }}">{{ 'general.breadcrumb.home' | t }}</a>
      <span>›</span><span class="cur">{{ 'cart.general.title' | t }}</span>
    </nav>
    <h1 class="shop-title">{{ 'cart.general.title' | t }}</h1>
  </div>
</div>

<section class="sec-sm">
  <div class="container">
    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart-g">
        <div>
          {%- for item in cart.items -%}
            <div class="cart-line" data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-thumb p-img" style="aspect-ratio:1">
                {% render 'product-media', product: item.product, size: 78 %}
              </a>
              <div>
                <span class="cart-brand">{{ item.product.vendor }}</span>
                <a href="{{ item.url }}" class="cart-name">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <span class="cart-size">{{ item.variant.title }}</span>
                {%- endunless -%}
                <div class="cart-unit">{{ item.original_price | money }} per stuk</div>
              </div>
              <div class="cart-right">
                <div class="qty-box sm">
                  <button type="button" class="qty-btn" data-dir="down" aria-label="Minder">−</button>
                  <input class="qty-input" type="number" name="updates[{{ item.key }}]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
                  <button type="button" class="qty-btn" data-dir="up" aria-label="Meer">+</button>
                </div>
                <div class="cart-line-total">{{ item.final_line_price | money }}</div>
                <a href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity=0" class="cart-remove">{{ 'cart.general.remove' | t }}</a>
              </div>
            </div>
          {%- endfor -%}
          <div style="margin-top:24px;display:flex;gap:14px;flex-wrap:wrap">
            <a href="{{ routes.all_products_collection_url }}" class="btn-s">← {{ 'cart.general.continue_shopping' | t }}</a>
            <button type="submit" name="update" class="btn-s">Winkelwagen bijwerken</button>
          </div>
        </div>

        <aside class="cart-summary">
          <div class="sum-title">Overzicht</div>
          <div class="sum-row"><span>{{ 'cart.general.subtotal' | t }}</span><span>{{ cart.total_price | money }}</span></div>
          {%- if threshold > 0 -%}
            {%- if cart.total_price >= threshold -%}
              <div class="sum-hint">{{ 'cart.general.free_shipping' | t }}</div>
            {%- else -%}
              {%- assign remaining = threshold | minus: cart.total_price | money -%}
              <div class="sum-hint">{{ 'cart.general.free_shipping_remaining' | t: amount: remaining }}</div>
            {%- endif -%}
          {%- endif -%}
          <div class="sum-row"><span>{{ 'cart.general.shipping' | t }}</span><span>{{ 'cart.general.shipping_calculated' | t }}</span></div>
          <div class="sum-total"><span>{{ 'cart.general.total' | t }}</span><span>{{ cart.total_price | money }}</span></div>
          <button type="submit" name="checkout" class="btn-p btn-lg sum-checkout">{{ 'cart.general.checkout' | t }}</button>
          <a href="{{ routes.all_products_collection_url }}" class="sum-cont">{{ 'cart.general.continue_shopping' | t }}</a>
        </aside>
      </form>
    {%- else -%}
      <div class="empty-cart">
        <p class="empty-msg">{{ 'cart.general.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-p btn-lg">{{ 'collections.general.view_all' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Winkelwagen", "settings": [] }
{% endschema %}
