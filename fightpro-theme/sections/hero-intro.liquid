{%- comment -%}
  3D scroll-intro (Three.js + GSAP). intro.js wordt in theme.liquid geladen
  op de homepage. Valt automatisch terug op een statische hero zonder WebGL,
  bij prefers-reduced-motion of lage FPS.
{%- endcomment -%}
<section class="intro" id="intro" aria-label="Introductie">
  <canvas class="intro-canvas" id="introCanvas" aria-hidden="true"></canvas>

  <div class="intro-fallback" id="introFallback" hidden>
    <div class="fb-grid" aria-hidden="true"></div>
    <div class="fb-glow" aria-hidden="true"></div>
  </div>

  <div class="chapter ch-1" id="ch1">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1 class="mega" aria-label="{{ section.settings.title }}{{ section.settings.title_accent }}">
      {%- assign chars = section.settings.title | split: '' -%}
      {%- for c in chars -%}<span class="ltr">{{ c }}</span>{%- endfor -%}
      {%- assign chars2 = section.settings.title_accent | split: '' -%}
      {%- for c in chars2 -%}<span class="ltr ac">{{ c }}</span>{%- endfor -%}
    </h1>
    {%- if section.settings.subtitle != blank -%}<p class="ch-sub">{{ section.settings.subtitle }}</p>{%- endif -%}
    <div class="scroll-hint" aria-hidden="true"><span></span>Scroll</div>
  </div>

  <div class="chapter ch-2" id="ch2" aria-hidden="true">
    <p class="line l1">{{ section.settings.claim_1 }}</p>
    <p class="line l2 ac">{{ section.settings.claim_2 }}</p>
    <p class="line l3">{{ section.settings.claim_3 }}</p>
  </div>

  <div class="chapter ch-3" id="ch3" aria-hidden="true">
    {%- if section.settings.lockup_eyebrow != blank -%}<p class="eyebrow">{{ section.settings.lockup_eyebrow }}</p>{%- endif -%}
    <p class="lockup">{{ section.settings.lockup_line_1 }}<br><span class="ac">{{ section.settings.lockup_line_2 }}</span></p>
    <div class="cta-row">
      {%- if section.settings.cta_text != blank -%}
        <a class="btn-p btn-lg" href="{{ section.settings.cta_link | default: '#shop' }}">{{ section.settings.cta_text }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
      {%- if section.settings.cta2_text != blank -%}
        <a class="btn-s btn-lg" href="{{ section.settings.cta2_link | default: '#over-ons' }}">{{ section.settings.cta2_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "3D scroll-intro",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Enschede · sinds 2020" },
    { "type": "text", "id": "title", "label": "Titel (wit)", "default": "FIGHT" },
    { "type": "text", "id": "title_accent", "label": "Titel (goud)", "default": "PRO" },
    { "type": "text", "id": "subtitle", "label": "Ondertitel", "default": "Dé vechtsportwinkel van Twente" },
    { "type": "header", "content": "Hoofdstuk 2 — claims" },
    { "type": "text", "id": "claim_1", "label": "Regel 1", "default": "Topmerken." },
    { "type": "text", "id": "claim_2", "label": "Regel 2 (goud)", "default": "Topprijzen." },
    { "type": "text", "id": "claim_3", "label": "Regel 3", "default": "Top advies." },
    { "type": "header", "content": "Hoofdstuk 3 — afsluiting" },
    { "type": "text", "id": "lockup_eyebrow", "label": "Eyebrow", "default": "Passen vóór kopen — 294+ producten · 25 merken" },
    { "type": "text", "id": "lockup_line_1", "label": "Regel 1", "default": "Train harder." },
    { "type": "text", "id": "lockup_line_2", "label": "Regel 2 (goud)", "default": "Vecht slimmer." },
    { "type": "text", "id": "cta_text", "label": "Knop 1 tekst", "default": "Bekijk de collectie" },
    { "type": "url", "id": "cta_link", "label": "Knop 1 link" },
    { "type": "text", "id": "cta2_text", "label": "Knop 2 tekst", "default": "Ons verhaal" },
    { "type": "url", "id": "cta2_link", "label": "Knop 2 link" }
  ],
  "presets": [ { "name": "3D scroll-intro" } ]
}
{% endschema %}
