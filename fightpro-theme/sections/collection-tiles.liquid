<section class="sec" id="shop" style="background:var(--black);">
<div class="container">
  <div class="tc fi">
    <div class="lbl">{{ section.settings.eyebrow }}</div>
    <h2 class="ttl">{{ section.settings.heading }}</h2>
    {%- if section.settings.subtitle != blank -%}<p class="sub">{{ section.settings.subtitle }}</p>{%- endif -%}
  </div>
  <div class="cats-g">
    {%- for block in section.blocks -%}
      {%- assign col = block.settings.collection -%}
      <a class="cat fi" href="{{ col.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        <div class="cat-bd">
          <div class="cat-tag">
            {%- if col != blank -%}{{ col.products_count }} producten{%- else -%}{{ block.settings.tag }}{%- endif -%}
          </div>
          <div class="cat-n">{% if block.settings.title != blank %}{{ block.settings.title }}{% elsif col != blank %}{{ col.title }}{% else %}Collectie{% endif %}</div>
          <div class="cat-a">Bekijk collectie <span>→</span></div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</div>
</section>

{% schema %}
{
  "name": "Collectie-tegels",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ons assortiment" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Alles voor de vechtsporter" },
    { "type": "text", "id": "subtitle", "label": "Subtitel", "default": "Van bokshandschoenen tot scheenbeschermers, van kids-lijnen tot voeding." }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tegel",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collectie" },
        { "type": "text", "id": "title", "label": "Titel (optioneel, anders collectienaam)" },
        { "type": "text", "id": "tag", "label": "Label (als geen collectie gekozen)", "default": "Shop" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "tile", "settings": { "title": "Bescherming" } },
      { "type": "tile", "settings": { "title": "Handschoenen" } },
      { "type": "tile", "settings": { "title": "Uitrusting" } },
      { "type": "tile", "settings": { "title": "Kids" } },
      { "type": "tile", "settings": { "title": "Voeding" } },
      { "type": "tile", "settings": { "title": "Kleding" } }
    ]
  },
  "presets": [ { "name": "Collectie-tegels" } ]
}
{% endschema %}
