<section class="hero">
  <div class="hero-in">
    <div class="fl vis">
      {%- if section.settings.badge != blank -%}
        <span class="hero-badge">{{ section.settings.badge }}</span>
      {%- endif -%}
      <h1>{{ section.settings.title | default: 'JOUW WINKEL' }}<span class="ac">{{ section.settings.title_accent | default: 'VOOR DE STRIJD' }}</span></h1>
      {%- if section.settings.subtitle != blank -%}
        <p class="hero-sub">{{ section.settings.subtitle }}</p>
      {%- endif -%}
      <div class="hero-btns">
        {%- if section.settings.cta1_text != blank -%}
          <a href="{{ section.settings.cta1_link | default: routes.all_products_collection_url }}" class="btn-p btn-lg">{{ section.settings.cta1_text }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link | default: '#merken' }}" class="btn-s btn-lg">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <div class="hero-trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' -%}
              <span class="ti" {{ block.shopify_attributes }}><span class="ti-ic">✓</span> {{ block.settings.text }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero-vis fr vis">
      <div class="hlw">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 600 | image_tag: alt: shop.name, widths: '300,450,600', loading: 'eager' }}
        {%- elsif section.settings.logo != blank -%}
          {{ section.settings.logo | image_url: width: 600 | image_tag: alt: shop.name }}
        {%- else -%}
          <span class="logo-text" style="font-family:'Bebas Neue';font-size:120px;color:var(--gold);letter-spacing:4px;">FP</span>
        {%- endif -%}
      </div>
      <div class="stats-g">
        {%- assign has_stats = false -%}
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}{%- assign has_stats = true -%}{%- endif -%}{%- endfor -%}
        {%- if has_stats -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'stat' -%}
              <div class="stat-b" {{ block.shopify_attributes }}>
                <div class="s-num">{{ block.settings.number }}</div>
                <div class="s-lbl">{{ block.settings.label }}</div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Sinds 2020 · Enschede" },
    { "type": "text", "id": "title", "label": "Titel", "default": "FIGHTPRO " },
    { "type": "text", "id": "title_accent", "label": "Titel (accent-regel)", "default": "ENSCHEDE" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitel", "default": "Dé vechtsportwinkel van Twente. Officiële dealer van Hayabusa, Twins, Joya, Fairtex, Booster en meer — voor de beginner én de prof." },
    { "type": "text", "id": "cta1_text", "label": "Knop 1 tekst", "default": "Shop de collectie" },
    { "type": "url", "id": "cta1_link", "label": "Knop 1 link" },
    { "type": "text", "id": "cta2_text", "label": "Knop 2 tekst", "default": "Onze merken" },
    { "type": "url", "id": "cta2_link", "label": "Knop 2 link" },
    { "type": "header", "content": "Visual" },
    { "type": "image_picker", "id": "image", "label": "Hero-afbeelding" },
    { "type": "image_picker", "id": "logo", "label": "Logo (fallback)" }
  ],
  "blocks": [
    { "type": "trust", "name": "Trust-item", "settings": [ { "type": "text", "id": "text", "label": "Tekst", "default": "Gratis verzending vanaf € 75" } ] },
    { "type": "stat", "name": "Statistiek", "settings": [
      { "type": "text", "id": "number", "label": "Getal", "default": "290+" },
      { "type": "text", "id": "label", "label": "Label", "default": "Producten" }
    ] }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
