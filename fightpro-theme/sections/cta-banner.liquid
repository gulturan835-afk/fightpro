<div class="cta-bd"><div class="cta-in">
  <div class="fi">
    <div class="cta-lb">{{ section.settings.eyebrow }}</div>
    <h2 class="cta-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="cta-p">{{ section.settings.text }}</p>{%- endif -%}
  </div>
  {%- if section.settings.cta_text != blank -%}
    <a href="{{ section.settings.cta_link | default: '#contact' }}" class="btn-dk fi d2">{{ section.settings.cta_text }}</a>
  {%- endif -%}
</div></div>

{% schema %}
{
  "name": "CTA-band",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Kom langs in Enschede" },
    { "type": "textarea", "id": "heading", "label": "Kop", "default": "Passen voor kopen. Altijd het goede advies." },
    { "type": "textarea", "id": "text", "label": "Tekst", "default": "In tegenstelling tot webshops kun je bij FightPro handschoenen en beschermers écht passen voordat je koopt." },
    { "type": "text", "id": "cta_text", "label": "Knoptekst", "default": "Winkel bezoeken →" },
    { "type": "url", "id": "cta_link", "label": "Knoplink" }
  ],
  "presets": [ { "name": "CTA-band" } ]
}
{% endschema %}
