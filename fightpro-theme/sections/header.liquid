<header id="hdr">
  <div class="header-wrap">
    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }} homepage">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 312 | image_tag: alt: shop.name, width: 156, height: 52, class: 'logo-img' }}
      {%- else -%}
        <span class="logo-text">{{ shop.name | default: 'FIGHT' }}<span class="ac">PRO</span></span>
      {%- endif -%}
    </a>

    <nav class="nav-d" role="navigation" aria-label="Hoofdnavigatie">
      {%- for link in section.settings.menu.links -%}
        {%- if link.links != blank -%}
          <div class="has-sub nav-item" tabindex="0" aria-haspopup="true">
            <a href="{{ link.url }}" style="color:inherit;padding:0;">{{ link.title }}</a> <span class="cv">▾</span>
            <div class="sub">
              {%- for child in link.links -%}
                <a href="{{ child.url }}">{{ child.title }}</a>
              {%- endfor -%}
            </div>
          </div>
        {%- else -%}
          <a href="{{ link.url }}" class="nav-item">{{ link.title }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="hdr-r">
      <form action="{{ routes.search_url }}" method="get" class="hdr-search" role="search">
        <button class="ib" type="submit" aria-label="Zoeken"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg></button>
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Zoeken…" aria-label="Zoeken naar producten">
      </form>
      <a href="{{ routes.cart_url }}" class="ib" aria-label="Winkelwagen" style="position:relative;">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span class="cb" id="cartBadge">{{ cart.item_count }}</span>
      </a>
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link | default: '#contact' }}" class="btn-p hdr-cta" style="padding:10px 22px;font-size:13px;">{{ section.settings.cta_text }}</a>
      {%- endif -%}
      <button class="ham" id="ham" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<nav class="mob-nav" id="mnav" aria-label="Mobiel menu">
  {%- for link in section.settings.menu.links -%}
    {%- if link.links != blank -%}
      <div class="mob-sec"><a href="{{ link.url }}" style="color:var(--gold)">{{ link.title }}</a></div>
      {%- for child in link.links -%}
        <a href="{{ child.url }}">{{ child.title }}</a>
      {%- endfor -%}
    {%- else -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endif -%}
  {%- endfor -%}
  <a href="{{ routes.cart_url }}" class="mob-cta">🛒 Naar winkelwagen</a>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "link_list", "id": "menu", "label": "Hoofdmenu", "default": "main-menu" },
    { "type": "text", "id": "cta_text", "label": "Knop tekst", "default": "Winkel bezoeken" },
    { "type": "url", "id": "cta_link", "label": "Knop link" }
  ]
}
{% endschema %}
