<footer>
  <div class="f-bar"></div>
  <div class="f-top">
    <div>
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 288 | image_tag: alt: shop.name, width: 144, height: 48, class: 'f-logo' }}
      {%- else -%}
        {{ 'logo.png' | asset_url | img_tag: shop.name, 'f-logo' }}
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="f-desc">{{ section.settings.description }}</p>
      {%- endif -%}
      <div class="f-contact">
        {%- if section.settings.address != blank -%}
          <div class="f-ct-row">{% render 'icon', name: 'pin' %}<span>{{ section.settings.address }}</span></div>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <div class="f-ct-row">{% render 'icon', name: 'phone' %}<a href="https://wa.me/{{ section.settings.phone | remove: ' ' | remove: '+' | remove: '(0)' }}">WhatsApp {{ section.settings.phone }}</a></div>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <div class="f-ct-row">{% render 'icon', name: 'mail' %}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></div>
        {%- endif -%}
      </div>
      <div class="pay-r"><span class="pay">iDEAL</span><span class="pay">VISA</span><span class="pay">MC</span><span class="pay">PAYPAL</span></div>
    </div>

    <div>
      <div class="f-ct">Openingstijden</div>
      <ul class="f-ls f-hours">
        {%- assign hour_lines = section.settings.hours | newline_to_br | split: '<br />' -%}
        {%- for line in hour_lines -%}
          {%- assign parts = line | strip | split: '|' -%}
          {%- if parts.size >= 1 and parts[0] != blank -%}
            <li><span class="f-day">{{ parts[0] | strip }}</span><span class="{% if parts[1] contains ':' %}f-time{% else %}f-closed{% endif %}">{{ parts[1] | strip | default: 'Gesloten' }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div>
      <div class="f-ct">Algemene info</div>
      <ul class="f-ls">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link' and block.settings.title != blank -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url }}">{{ block.settings.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.extra_menu != blank -%}
          {%- for link in section.settings.extra_menu.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>

    <div>
      <div class="f-ct">Merken</div>
      <ul class="f-ls f-cols">
        {%- assign brand_list = section.settings.brands | split: ',' -%}
        {%- for brand in brand_list -%}
          {%- assign b = brand | strip -%}
          {%- if b != blank -%}
            <li><a href="{{ routes.collections_url }}/vendors?q={{ b | url_encode }}">{{ b }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  <div class="f-bot">
    <div class="f-bot-in">
      <p class="f-cp">{{ section.settings.copyright }} — {{ 'now' | date: '%Y' }}</p>
      <div class="f-lg">
        {%- if section.settings.legal_menu != blank -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="/policies/privacy-policy">Privacy</a>
          <a href="/policies/terms-of-service">Voorwaarden</a>
          <a href="/policies/refund-policy">Retourneren</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "textarea", "id": "description", "label": "Omschrijving", "default": "Dé vechtsportwinkel van Twente. Officiële dealer van 25 topmerken. Geopend in 2020 in Enschede." },
    { "type": "header", "content": "Contact" },
    { "type": "textarea", "id": "address", "label": "Adres", "default": "Lipperkerkstraat 19, 7511 CT Enschede" },
    { "type": "text", "id": "phone", "label": "Telefoon / WhatsApp", "default": "+31 6 340 397 34" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "info@fightpro.nl" },
    { "type": "header", "content": "Openingstijden (per regel: Dag | Tijd)" },
    { "type": "textarea", "id": "hours", "label": "Openingstijden", "default": "Maandag | Gesloten\nDinsdag | 13:00 – 18:00\nWoensdag | 13:00 – 18:00\nDonderdag | 13:00 – 18:00\nVrijdag | 13:00 – 18:00\nZaterdag | 10:00 – 16:00\nZondag | Gesloten" },
    { "type": "header", "content": "Extra menu's" },
    { "type": "link_list", "id": "extra_menu", "label": "Extra info-menu (optioneel)" },
    { "type": "link_list", "id": "legal_menu", "label": "Juridisch menu (onderin)" },
    { "type": "header", "content": "Merken" },
    { "type": "textarea", "id": "brands", "label": "Merken (komma-gescheiden)", "default": "Adidas, Bio Tech, Booster, Crossmaxx, Danger, ESN, Fairtex, Fightpro, Hayabusa, Joya, King, Lifemaxx, Makura, Matchu, Namman Muay, PX, Queen, Shockdoctor, Smai, Super Pro, Tatami Fightwear, Twins, UFC, Venum, Windy" },
    { "type": "text", "id": "copyright", "label": "Copyright", "default": "© FightPro Enschede — by FP Fight Gear®. Alle rechten voorbehouden." }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Info-link",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Contact" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link", "settings": { "title": "Contact" } },
      { "type": "link", "settings": { "title": "Interessante artikelen" } },
      { "type": "link", "settings": { "title": "Club, instelling of sportschool?" } },
      { "type": "link", "settings": { "title": "Wie zijn wij?" } },
      { "type": "link", "settings": { "title": "Promotie" } }
    ]
  }
}
{% endschema %}
