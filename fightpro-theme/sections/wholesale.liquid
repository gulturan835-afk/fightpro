<section class="sec-sm" id="groothandel" style="background:var(--black);">
<div class="container"><div class="wh-g">
  <div class="wh-co fl">
    <div class="lbl">{{ section.settings.eyebrow }}</div>
    <h2 class="ab-ttl">{{ section.settings.heading }}</h2>
    <div class="ab-p" style="margin-bottom:28px;">{{ section.settings.text }}</div>
    <div style="display:flex;gap:14px;flex-wrap:wrap;">
      {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}" class="btn-p">E-mail ons →</a>{%- endif -%}
      {%- if section.settings.phone != blank -%}<a href="tel:{{ section.settings.phone | remove: ' ' }}" class="btn-s">{{ section.settings.phone }}</a>{%- endif -%}
    </div>
  </div>
  <div class="wh-vi fr">
    {%- for block in section.blocks -%}
      <div class="wh-it" {{ block.shopify_attributes }}>
        <div class="wh-t">{{ block.settings.title }}</div>
        <div class="wh-p">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
  </div>
</div></div>
</section>

{% schema %}
{
  "name": "Groothandel",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Voor clubs & instellingen" },
    { "type": "text", "id": "heading", "label": "Kop", "default": "Officiële groothandel" },
    { "type": "richtext", "id": "text", "label": "Tekst", "default": "<p>FightPro is niet alleen een winkel — we zijn een officiële groothandel. Heeft u een sportschool, club of vereniging? Neem contact op voor speciale inkoopprijzen.</p>" },
    { "type": "text", "id": "email", "label": "E-mail", "default": "info@fightpro.nl" },
    { "type": "text", "id": "phone", "label": "Telefoon", "default": "06 340 397 34" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Dienst",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Teamkleding" },
        { "type": "text", "id": "text", "label": "Tekst", "default": "Trainingspakken, shirts en tassen met uw logo" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "title": "Teamkleding", "text": "Trainingspakken, shirts, handdoeken en bidons met uw logo" } },
      { "type": "item", "settings": { "title": "Vechtsport uitrusting", "text": "Bokszakken, pads, handschoenen met uw huisstijl" } },
      { "type": "item", "settings": { "title": "Sportschool interieur", "text": "Spandoeken, aluminium borden, textieldoeken en vlaggen" } },
      { "type": "item", "settings": { "title": "Drukwerk & reclame", "text": "Posters, flyers, polsbandjes, stickers en entreekaartjes" } },
      { "type": "item", "settings": { "title": "Website op maat", "text": "Professionele website voor uw sportschool of bedrijf" } }
    ]
  },
  "presets": [ { "name": "Groothandel" } ]
}
{% endschema %}
