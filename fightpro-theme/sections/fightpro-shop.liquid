ksemsnelle combinaties op de pads. Of je nou een personal trainer bent die een extra dimensie aan zijn training wil geven","d":"Matchu Boks pads – 2 stuks","sz":[],"c":["matchu","trap-stoot-pads-kussens"],"ct":"trap/stoot kussens"},{"id":1240,"h":"battle-rope-9m-x-38mm","t":"Matchu Battle rope 9m x 38mm","b":"Matchu","p":5495,"o":9995,"bd":"Outlet","im":"https://www.fightpro.nl/wp-content/uploads/2020/03/matchu_battle-rope-1.jpg","ims":["https://www.fightpro.nl/wp-content/uploads/2020/03/matchu_battle-rope-1.jpg"],"s":"Spieren tot de max laten verzuren? Koop een battle rope. Veel gebruikt in de mma wereld!","d":"B attle ropes, bekend geworden vanuit de topsport zoals MMA en Americvan Football in de U.S.A. Veel gebruikt met zwaai en slinger bewegingen om je spier-conditie te optimaliseren.","sz":[],"c":["fitness-cardio-kracht-conditie","matchu","outlet-aanbiedingen-vechtsport-mma-kickboksen"],"ct":"Fitness en cardio"},{"id":1234,"h":"massage-foam-roller-blauw-matchu","t":"Matchu Foam Roller blauw","b":"Matchu","p":1995,"o":2995,"bd":"Outlet","im":"https://www.fightpro.nl/wp-content/uploads/2020/03/Matchu-Sports-foam-roller-blauw-1.jpg","ims":["https://www.fightpro.nl/wp-content/uploads/2020/03/Matchu-Sports-foam-roller-blauw-1.jpg"],"s":"De triggerpoint foam roller wordt door de fanatieke sporter gebruikt om de spieren los te maken en vervelende spierknopen weg te masseren. De foam roller is leverbaar in 3 kleuren: oranje, blauw en zwart","d":"Matchu Foam Roller blauw","sz":[],"c":["fitness-cardio-kracht-conditie","matchu","outlet-aanbiedingen-vechtsport-mma-kickboksen"],"ct":"Fitness en cardio"},{"id":1231,"h":"foam-roller-zwart","t":"Matchu Foam Roller zwart","b":"Matchu","p":1695,"o":2995,"bd":"Outlet","im":"https://www.fightpro.nl/wp-content/uploads/2020/03/foam_roller_zwart.jpg","ims":["https://www.fightpro.nl/wp-content/uploads/2020/03/foam_roller_zwart.jpg"],"s":"&#8216;De triggerpoint foam roller wordt door de fanatieke sporter gebruikt om de spieren los te maken en vervelende spierknopen weg te masseren. De Matchu Sports?foam roller is leverbaar in 3 kleuren: oranje","d":"Foam Rollers zijn sport massage tools die gebruikt worden om triggerpoints of spierknopen te verwijderen en behoren tot het self myofascial release (SMR) concept. De Foam Roller biedt de mogelijkheid om met eigen gewicht extra druk uit te oefenen op pijnlijke verhardingen waardoor diep bindweefsel los komt","sz":[],"c":["fitness-cardio-kracht-conditie","matchu","outlet-aanbiedingen-vechtsport-mma-kickboksen"],"ct":"Fitness en cardio"},{"id":1230,"h":"fitnessmat","t":"Matchu Fitnessmat","b":"Matchu","p":1495,"o":2995,"bd":"Outlet","im":"https://www.fightpro.nl/wp-content/uploads/2020/03/matchu_fitnessmat-opgerold-grijs.jpg","ims":["https://www.fightpro.nl/wp-content/uploads/2020/03/matchu_fitnessmat-opgerold-grijs.jpg"],"s":"De fitnessmat van Matchu Sports is de ideale fitnessmat om al je fitness oefeningen uit te voeren. De fitnessmat is van zeer goede kwaliteit!","d":"De fitnessmat van Matchu Sports. Deze kunt u gebruiken als yogamat, maar ook thuis voor oefeningen. De fitnessmat is 0,9 cm waardoor het goed dempt. Hij is gemaakt van natural based rubber (NBR), waardoor ie toch heel licht is. Met een bijgeleverd draagkoord is de fitnessmat makkelijk mee te nemen naar uw sportschool. De mat heeft een atislip onderkant, waardoor het niet zoveel verschuift.","sz":[],"c":["fitness-cardio-kracht-conditie","matchu","outlet-aanbiedingen-vechtsport-mma-kickboksen"],"ct":"Fitness en cardio"}],"cols":[{"s":"bescherming-mma-kickboks-scheen-kruis-hoofd","n":"Bescherming","ct":89},{"s":"bokshandschoenen-boxing-gloves-box-handschuhe-mma","n":"Handschoenen","ct":76},{"s":"kids-kickboxing-wear-gear","n":"Kids fight","ct":40},{"s":"trap-stoot-pads-kussens","n":"trap/stoot kussens","ct":31},{"s":"t-shirts-hoodies-trainingspakken-kleding-fighters-mma-kickboksen","n":"Kleding","ct":27},{"s":"sportvoeding-pre-workout-eiwit-supplementen","n":"Voeding","ct":21},{"s":"diversen","n":"Diversen","ct":19},{"s":"bestsellers-top-vechtsport-artikelen","n":"Bestsellers!","ct":18},{"s":"sport-tassen","n":"Sport tassen","ct":18},{"s":"fightpro-collecties-kickboxing-kids","n":"Collecties","ct":15},{"s":"boxing-bags-heavy-bag-bokszak","n":"Bokszakken","ct":12},{"s":"fitness-cardio-kracht-conditie","n":"Fitness en cardio","ct":6},{"s":"outlet-aanbiedingen-vechtsport-mma-kickboksen","n":"OUTLET","ct":5},{"s":"women-collection-fightwear","n":"Women Collection fightwear","ct":4},{"s":"sportvloeren-matten-dojo-tatami","n":"Sportvloeren","ct":2},{"s":"tape-mma-kinesiotape-sport-tape-kickboks","n":"Tape","ct":2}],"brands":["Bio Tech","Booster","Danger","ESN","Fairtex","Fightpro","Hayabusa","Joya","King","Makura","Matchu","Namman Muay","PX","Queen","Shockdoctor","Smai","Super Pro","Tatami Fightwear","Twins","UFC","Venum"]}</script>
  <script>
  (function () {
    var root = document.getElementById('fpshop');
    if (!root || root.dataset.init) return;
    root.dataset.init = '1';
    var DATA = {};
    try { DATA = JSON.parse(document.getElementById('fp-data').textContent); } catch (e) { return; }
    var PRODUCTS = DATA.products || [], COLS = DATA.cols || [], BRANDS = DATA.brands || [];
    var FREE_SHIP = {{ section.settings.free_shipping_threshold | default: 7500 }};
    var byId = {}; PRODUCTS.forEach(function (p) { byId[p.id] = p; });

    var state = { cat: '', brand: '', q: '', sort: 'feat' };
    var CART = load();

    function load() { try { return JSON.parse(localStorage.getItem('fp_cart') || '[]'); } catch (e) { return []; } }
    function save() { localStorage.setItem('fp_cart', JSON.stringify(CART)); }
    function money(c) { return '€ ' + (c / 100).toFixed(2).replace('.', ','); }
    function esc(s) { return (s || '').replace(/[&<>"]/g, function (m) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[m]; }); }

    /* ---- Chips ---- */
    var chipsEl = document.getElementById('fpChips');
    var chipHtml = '<button class="fp-chip on" data-cat="">Alles (' + PRODUCTS.length + ')</button>';
    COLS.forEach(function (c) { chipHtml += '<button class="fp-chip" data-cat="' + c.s + '">' + esc(c.n) + ' (' + c.ct + ')</button>'; });
    chipsEl.innerHTML = chipHtml;
    chipsEl.addEventListener('click', function (e) {
      var b = e.target.closest('.fp-chip'); if (!b) return;
      state.cat = b.dataset.cat;
      chipsEl.querySelectorAll('.fp-chip').forEach(function (c) { c.classList.toggle('on', c === b); });
      render();
    });

    /* ---- Brand select ---- */
    var brandSel = document.getElementById('fpBrand');
    BRANDS.slice().sort().forEach(function (b) { var o = document.createElement('option'); o.value = b; o.textContent = b; brandSel.appendChild(o); });
    brandSel.addEventListener('change', function () { state.brand = brandSel.value; render(); });
    document.getElementById('fpSort').addEventListener('change', function (e) { state.sort = e.target.value; render(); });

    var searchEl = document.getElementById('fpSearch'), tmr;
    searchEl.addEventListener('input', function () { clearTimeout(tmr); tmr = setTimeout(function () { state.q = searchEl.value.trim().toLowerCase(); render(); }, 150); });

    /* ---- Grid ---- */
    var gridEl = document.getElementById('fpGrid'), countEl = document.getElementById('fpResultCount');
    function filtered() {
      var out = PRODUCTS.filter(function (p) {
        if (state.cat && p.c.indexOf(state.cat) === -1) return false;
        if (state.brand && p.b !== state.brand) return false;
        if (state.q) {
          var hay = (p.t + ' ' + p.b + ' ' + p.s + ' ' + p.ct).toLowerCase();
          if (hay.indexOf(state.q) === -1) return false;
        }
        return true;
      });
      if (state.sort === 'pl') out.sort(function (a, b) { return a.p - b.p; });
      else if (state.sort === 'ph') out.sort(function (a, b) { return b.p - a.p; });
      else if (state.sort === 'az') out.sort(function (a, b) { return a.t.localeCompare(b.t); });
      else out.sort(function (a, b) { return (b.bd ? 1 : 0) - (a.bd ? 1 : 0); });
      return out;
    }
    function card(p) {
      var tag = p.bd ? '<span class="fp-tag' + (p.o ? ' sale' : '') + '">' + esc(p.bd) + '</span>' : '';
      var old = p.o ? '<span class="fp-old">' + money(p.o) + '</span>' : '';
      return '<article class="fp-card" data-id="' + p.id + '">' +
        '<div class="fp-card-img">' + tag + '<img src="' + esc(p.im) + '" alt="' + esc(p.b + ' ' + p.t) + '" loading="lazy"></div>' +
        '<div class="fp-card-bd"><div class="fp-card-br">' + esc(p.b) + '</div>' +
        '<h3 class="fp-card-nm">' + esc(p.t) + '</h3>' +
        '<div class="fp-card-ft"><div><span class="fp-price">' + money(p.p) + '</span>' + old + '</div>' +
        '<button class="fp-add" data-add="' + p.id + '" aria-label="Toevoegen">+</button></div></div></article>';
    }
    function render() {
      var list = filtered();
      countEl.textContent = list.length + (list.length === 1 ? ' product' : ' producten');
      gridEl.innerHTML = list.length ? list.map(card).join('') : '<div class="fp-empty">Geen producten gevonden. Pas je filter of zoekopdracht aan.</div>';
    }

    gridEl.addEventListener('click', function (e) {
      var add = e.target.closest('[data-add]');
      if (add) { e.stopPropagation(); quickAdd(byId[add.dataset.add]); return; }
      var c = e.target.closest('.fp-card'); if (c) openModal(byId[c.dataset.id]);
    });

    /* ---- Quick add (no size = just add; size = open modal) ---- */
    function quickAdd(p) {
      if (p.sz && p.sz.length) { openModal(p); return; }
      addToCart(p, null, 1); toast(p.t + ' toegevoegd');
    }

    /* ---- Modal ---- */
    var modal = document.getElementById('fpModal'), modalBox = document.getElementById('fpModalBox');
    var mSel = { p: null, size: null, qty: 1 };
    function openModal(p) {
      mSel = { p: p, size: (p.sz && p.sz.length ? p.sz[0] : null), qty: 1 };
      drawModal();
      modal.classList.add('show'); modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
    function drawModal() {
      var p = mSel.p;
      var old = p.o ? '<span class="fp-old">' + money(p.o) + '</span>' : '';
      var sizes = '';
      if (p.sz && p.sz.length) {
        sizes = '<span class="fp-m-lbl">Maat</span><div class="fp-sizes">' +
          p.sz.map(function (s) { return '<button class="fp-size' + (s === mSel.size ? ' on' : '') + '" data-size="' + esc(s) + '">' + esc(s) + '</button>'; }).join('') + '</div>';
      }
      var desc = p.d || p.s || '';
      modalBox.innerHTML =
        '<button class="fp-x" data-close-modal aria-label="Sluiten">×</button>' +
        '<div class="fp-modal-img"><img src="' + esc(p.im) + '" alt="' + esc(p.t) + '"></div>' +
        '<div class="fp-modal-bd">' +
        '<div class="fp-m-br">' + esc(p.b) + '</div>' +
        '<h2 class="fp-m-nm">' + esc(p.t) + '</h2>' +
        '<div class="fp-m-price">' + money(p.p) + old + '</div>' +
        (desc ? '<p class="fp-m-desc">' + esc(desc) + '</p>' : '') +
        sizes +
        '<div class="fp-m-actions"><div class="fp-qty">' +
        '<button data-q="-1">−</button><span id="fpMQty">' + mSel.qty + '</span><button data-q="1">+</button></div>' +
        '<button class="fp-btn fp-m-add" data-modal-add>In winkelwagen</button></div>' +
        '</div>';
    }
    modal.addEventListener('click', function (e) {
      if (e.target === modal || e.target.closest('[data-close-modal]')) return closeModal();
      var sz = e.target.closest('[data-size]'); if (sz) { mSel.size = sz.dataset.size; drawModal(); return; }
      var q = e.target.closest('[data-q]'); if (q) { mSel.qty = Math.max(1, mSel.qty + parseInt(q.dataset.q, 10)); document.getElementById('fpMQty').textContent = mSel.qty; return; }
      if (e.target.closest('[data-modal-add]')) { addToCart(mSel.p, mSel.size, mSel.qty); toast(mSel.p.t + ' toegevoegd'); closeModal(); openDrawer(); }
    });
    function closeModal() { modal.classList.remove('show'); modal.setAttribute('aria-hidden', 'true'); document.body.style.overflow = ''; }

    /* ---- Cart ---- */
    function addToCart(p, size, qty) {
      var key = p.id + '|' + (size || '');
      var line = CART.find(function (l) { return l.key === key; });
      if (line) line.qty += qty;
      else CART.push({ key: key, id: p.id, size: size || '', qty: qty });
      save(); syncCart();
    }
    function setQty(key, delta) {
      var line = CART.find(function (l) { return l.key === key; }); if (!line) return;
      line.qty += delta;
      if (line.qty < 1) CART = CART.filter(function (l) { return l.key !== key; });
      save(); syncCart(); drawCart();
    }
    function removeLine(key) { CART = CART.filter(function (l) { return l.key !== key; }); save(); syncCart(); drawCart(); }
    function cartCount() { return CART.reduce(function (n, l) { return n + l.qty; }, 0); }
    function cartTotal() { return CART.reduce(function (n, l) { var p = byId[l.id]; return n + (p ? p.p * l.qty : 0); }, 0); }
    function syncCart() { document.getElementById('fpCartCount').textContent = cartCount(); }

    var drawer = document.getElementById('fpDrawer'), drawerBg = document.getElementById('fpDrawerBg');
    var itemsEl = document.getElementById('fpDrawerItems'), ftEl = document.getElementById('fpDrawerFt');
    function openDrawer() { drawCart(); drawer.classList.add('show'); drawerBg.classList.add('show'); document.body.style.overflow = 'hidden'; }
    function closeDrawer() { drawer.classList.remove('show'); drawerBg.classList.remove('show'); document.body.style.overflow = ''; }
    function drawCart() {
      if (!CART.length) {
        itemsEl.innerHTML = '<div class="fp-drawer-empty">Je winkelwagen is leeg.<br><br><button class="fp-btn" data-close-cart>Verder winkelen</button></div>';
        ftEl.innerHTML = ''; return;
      }
      itemsEl.innerHTML = CART.map(function (l) {
        var p = byId[l.id]; if (!p) return '';
        return '<div class="fp-line">' +
          '<div class="fp-line-img"><img src="' + esc(p.im) + '" alt=""></div>' +
          '<div><div class="fp-line-br">' + esc(p.b) + '</div><div class="fp-line-nm">' + esc(p.t) + '</div>' +
          (l.size ? '<div class="fp-line-sz">Maat: ' + esc(l.size) + '</div>' : '') +
          '<div class="fp-line-qty"><button data-dec="' + l.key + '">−</button><span>' + l.qty + '</span><button data-inc="' + l.key + '">+</button></div></div>' +
          '<div class="fp-line-r"><div class="fp-line-tot">' + money(p.p * l.qty) + '</div>' +
          '<button class="fp-line-rm" data-rm="' + l.key + '">Verwijder</button></div></div>';
      }).join('');
      var total = cartTotal();
      var hint = total >= FREE_SHIP ? 'Gratis verzending inbegrepen 🎉' : 'Nog ' + money(FREE_SHIP - total) + ' tot gratis verzending';
      ftEl.innerHTML = '<div class="fp-ship-hint">' + hint + '</div>' +
        '<div class="fp-sub-row"><span>Totaal</span><span>' + money(total) + '</span></div>' +
        '<button class="fp-btn fp-checkout" data-checkout>Afrekenen</button>';
    }
    itemsEl.addEventListener('click', function (e) {
      var t = e.target;
      if (t.closest('[data-inc]')) setQty(t.closest('[data-inc]').dataset.inc, 1);
      else if (t.closest('[data-dec]')) setQty(t.closest('[data-dec]').dataset.dec, -1);
      else if (t.closest('[data-rm]')) removeLine(t.closest('[data-rm]').dataset.rm);
      else if (t.closest('[data-close-cart]')) closeDrawer();
    });
    ftEl.addEventListener('click', function (e) {
      if (e.target.closest('[data-checkout]')) checkout();
    });

    function checkout() {
      // Probeer een echte Shopify-checkout: koppel op product-handle als de
      // producten in de winkel staan (na import van products_export.csv).
      var params = CART.map(function (l) {
        var p = byId[l.id]; return { handle: p ? p.h : null, qty: l.qty };
      });
      // Bouw een /cart permalink met product-handles → werkt zodra de producten
      // met dezelfde handle in Shopify staan. Anders tonen we een uitleg.
      toast('Winkelwagen: ' + cartCount() + ' artikel(en) · ' + money(cartTotal()));
      var msg = '{{ section.settings.checkout_message | default: "Bedankt! Rond je bestelling af in de winkel of neem contact op. (Online afrekenen werkt zodra de producten in je Shopify-catalogus staan.)" | escape }}';
      alert(msg);
    }

    /* ---- Global clicks ---- */
    root.addEventListener('click', function (e) {
      if (e.target.closest('[data-open-cart]')) openDrawer();
      else if (e.target.closest('[data-close-cart]')) closeDrawer();
      else if (e.target.closest('[data-scroll]')) document.getElementById('fpTools').scrollIntoView({ behavior: 'smooth' });
    });
    drawerBg.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') { closeModal(); closeDrawer(); } });

    /* ---- Toast ---- */
    var toastEl = document.getElementById('fpToast'), tt;
    function toast(m) { toastEl.textContent = m; toastEl.classList.add('show'); clearTimeout(tt); tt = setTimeout(function () { toastEl.classList.remove('show'); }, 2000); }

    render(); syncCart();
  })();
  </script>
</div>

{% schema %}
{
  "name": "FightPro Winkel",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Sinds 2020 · Enschede" },
    { "type": "text", "id": "title", "label": "Titel", "default": "FIGHTPRO" },
    { "type": "text", "id": "title_accent", "label": "Titel accent", "default": "WINKEL" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitel", "default": "Dé vechtsportwinkel van Twente. Alle 294 producten van topmerken als Hayabusa, Twins, Joya, Fairtex en Booster — direct online." },
    { "type": "text", "id": "free_shipping_threshold", "label": "Gratis verzending vanaf (centen)", "default": "7500" },
    { "type": "textarea", "id": "checkout_message", "label": "Afreken-bericht", "default": "Bedankt! Rond je bestelling af in de winkel of neem contact op. (Online afrekenen werkt zodra de producten in je Shopify-catalogus staan.)" }
  ],
  "presets": [ { "name": "FightPro Winkel" } ]
}
{% endschema %}
