nen_BGVL3-Wine-Red.jpg","https://www.fightpro.nl/wp-content/uploads/2020/07/Twins_kickbokshandschoenen_BGVL3-Wine-Red2.jpg"],"s":"","d":"TWINS handschoenen. voor de serieuze en professionele sporter.","sz":["14 oz","16 oz"],"c":["bokshandschoenen-boxing-gloves-box-handschuhe-mma","kickboxing-gloves-leather-handschoenen-leer","twins-fightgear-kickboks-mma"],"ct":"Handschoenen"},{"id":4072,"h":"hayabusa-t3-boxing-gloves-charcoal-black-14-oz","t":"Hayabusa T3 Boxing Gloves – Black","b":"Hayabusa","p":17900,"o":0,"bd":"","im":"https://www.fightpro.nl/wp-content/uploads/2020/07/hayabusa_t3_black.jpg","ims":["https://www.fightpro.nl/wp-content/uploads/2020/07/hayabusa_t3_black.jpg"],"s":"Al jaren bekend als een van de beste handschoen merken in de wereld.","d":"Hayabusa handschoenen van zeer goede kwaliteit. Prijswinnaar van Men’s Health in 2019 voor beste Gloves in the world! voor de serieuze en professionele sporter.","sz":["14 oz","16 oz"],"c":["bokshandschoenen-boxing-gloves-box-handschuhe-mma","hayabusa-fightwear-nederland-deutschland","kickboxing-gloves-leather-handschoenen-leer"],"ct":"Handschoenen"},{"id":4045,"h":"joya-fight-fast-faded-black-kickbokshandschoenen-leer","t":"Joya &#8220;Fight Fast&#8221; Faded Black kickbokshandschoenen Leer","b":"Joya","p":9495,"o":0,"bd":"","im":"https://www.fightpro.nl/wp-content/uploads/2020/07/Joya-Kickbokshandschoenen-Fight-Fast-leer-zwart.jpg","ims":["https://www.fightpro.nl/wp-content/uploads/2020/07/Joya-Kickbokshandschoenen-Fight-Fast-leer-zwart.jpg","https://www.fightpro.nl/wp-content/uploads/2020/07/Joya-Kickbokshandschoenen-Fight-Fast-leer-zwart2.jpg"],"s":"Meest verkcohte kickbokshandschoen van Joya Fight Gear","d":"Goede handschoenen van Joya voor de serieuze sporter, goede kwaliteit voor een mooie prijs!","sz":["10 oz","12 oz","14 oz","16 oz"],"c":["bokshandschoenen-boxing-gloves-box-handschuhe-mma","joya-gear-vechtsport-artikelen","kickboxing-gloves-leather-handschoenen-leer"],"ct":"Handschoenen"},{"id":2629,"h":"j