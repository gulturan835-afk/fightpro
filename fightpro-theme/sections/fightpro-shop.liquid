{%- comment -%}
  FightPro — zelfstandige winkel-sectie.
  Alle 294 producten van fightpro.nl zijn hierin ingebakken. Werkt meteen als je
  de sectie toevoegt: categorie-filter, zoeken, productvenster en winkelwagen
  draaien volledig in de browser (geen import nodig om het te tonen).
  Toevoegen: Thema bewerken → Sectie toevoegen → "FightPro Winkel".
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Bebas+Neue&display=swap" rel="stylesheet">

<div id="fpshop" data-section="{{ section.id }}">
  <style>
    #fpshop{--gold:#B8973A;--gold-l:#D4AF5A;--black:#080808;--black2:#0F0F0F;--surface:#141414;--surface2:#1C1C1C;--border:rgba(255,255,255,.08);--border-g:rgba(184,151,58,.25);--text:#F5F5F0;--text-s:#9a9a9a;--text-m:#5a5a5a;--r:8px;--r-l:16px;font-family:"Inter",system-ui,sans-serif;background:var(--black);color:var(--text);line-height:1.6;}
    #fpshop *,#fpshop *::before,#fpshop *::after{box-sizing:border-box;margin:0;padding:0;}
    #fpshop img{max-width:100%;display:block;}
    #fpshop a{text-decoration:none;color:inherit;}
    #fpshop button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit;}
    #fpshop .fp-wrap{max-width:1280px;margin:0 auto;padding:0 24px;}
    /* Hero */
    #fpshop .fp-hero{background:var(--black2);border-bottom:1px solid var(--border);padding:64px 0 56px;position:relative;overflow:hidden;}
    #fpshop .fp-hero::after{content:"";position:absolute;width:600px;height:600px;background:radial-gradient(circle,rgba(184,151,58,.08),transparent 70%);top:-200px;right:-120px;pointer-events:none;}
    #fpshop .fp-badge{display:inline-block;font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gold);border:1px solid var(--border-g);border-radius:100px;padding:6px 14px;margin-bottom:18px;}
    #fpshop .fp-h1{font-family:"Bebas Neue",sans-serif;font-size:clamp(44px,7vw,84px);line-height:.95;letter-spacing:1px;color:#fff;}
    #fpshop .fp-h1 span{color:var(--gold);}
    #fpshop .fp-sub{font-size:16px;color:var(--text-s);max-width:560px;margin:18px 0 28px;}
    #fpshop .fp-hero-btns{display:flex;gap:12px;flex-wrap:wrap;}
    /* Buttons */
    #fpshop .fp-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:14px;font-weight:700;background:var(--gold);color:var(--black);padding:13px 26px;border-radius:var(--r);transition:background .2s,transform .15s;}
    #fpshop .fp-btn:hover{background:var(--gold-l);transform:translateY(-1px);}
    #fpshop .fp-btn-s{background:transparent;color:var(--text);border:1px solid var(--border);}
    #fpshop .fp-btn-s:hover{border-color:var(--border-g);background:rgba(255,255,255,.04);}
    #fpshop .fp-btn[disabled]{opacity:.5;cursor:not-allowed;transform:none;}
    /* Toolbar */
    #fpshop .fp-tools{position:sticky;top:0;z-index:30;background:rgba(8,8,8,.95);backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:16px 0;}
    #fpshop .fp-tools-in{display:flex;gap:14px;align-items:center;flex-wrap:wrap;}
    #fpshop .fp-search{flex:1;min-width:180px;display:flex;align-items:center;gap:8px;background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:10px 14px;}
    #fpshop .fp-search input{flex:1;background:none;border:none;outline:none;color:var(--text);font-size:14px;font-family:inherit;}
    #fpshop .fp-search svg{width:16px;height:16px;stroke:var(--text-m);fill:none;stroke-width:2;}
    #fpshop .fp-sel{background:var(--surface);border:1px solid var(--border);border-radius:var(--r);padding:10px 14px;color:var(--text);font-size:13px;font-family:inherit;outline:none;cursor:pointer;}
    #fpshop .fp-cart-btn{position:relative;background:var(--gold);color:var(--black);border-radius:var(--r);padding:10px 16px;font-weight:700;font-size:13px;display:inline-flex;align-items:center;gap:8px;}
    #fpshop .fp-cart-btn svg{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:2;}
    #fpshop .fp-cart-count{background:var(--black);color:var(--gold);border-radius:100px;min-width:20px;height:20px;display:inline-flex;align-items:center;justify-content:center;font-size:11px;padding:0 5px;}
    /* Chips */
    #fpshop .fp-chips{display:flex;gap:10px;flex-wrap:wrap;padding:20px 0 4px;}
    #fpshop .fp-chip{font-size:13px;font-weight:500;color:var(--text-s);background:var(--surface);border:1px solid var(--border);padding:8px 16px;border-radius:100px;transition:all .15s;white-space:nowrap;}
    #fpshop .fp-chip:hover{color:var(--gold);border-color:var(--border-g);}
    #fpshop .fp-chip.on{color:var(--black);background:var(--gold);border-color:var(--gold);font-weight:700;}
    #fpshop .fp-count{font-size:13px;color:var(--text-m);margin:16px 0;}
    /* Grid */
    #fpshop .fp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;padding-bottom:80px;}
    #fpshop .fp-card{background:var(--surface);display:flex;flex-direction:column;overflow:hidden;position:relative;transition:transform .25s,box-shadow .25s;cursor:pointer;}
    #fpshop .fp-card:hover{transform:translateY(-4px);box-shadow:0 20px 50px rgba(0,0,0,.5);z-index:2;}
    #fpshop .fp-card-img{aspect-ratio:1;background:#fff;display:flex;align-items:center;justify-content:center;overflow:hidden;position:relative;}
    #fpshop .fp-card-img img{width:100%;height:100%;object-fit:contain;padding:12px;transition:transform .3s;}
    #fpshop .fp-card:hover .fp-card-img img{transform:scale(1.05);}
    #fpshop .fp-tag{position:absolute;top:12px;left:12px;font-size:10px;font-weight:700;letter-spacing:.5px;padding:4px 10px;border-radius:4px;background:var(--gold);color:var(--black);z-index:2;}
    #fpshop .fp-tag.sale{background:#fff;}
    #fpshop .fp-card-bd{padding:16px 16px 18px;display:flex;flex-direction:column;flex:1;}
    #fpshop .fp-card-br{font-size:10px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:5px;}
    #fpshop .fp-card-nm{font-size:14px;font-weight:600;color:#fff;line-height:1.35;margin-bottom:12px;flex:1;}
    #fpshop .fp-card-ft{display:flex;align-items:center;justify-content:space-between;gap:8px;}
    #fpshop .fp-price{font-family:"Bebas Neue",sans-serif;font-size:24px;color:#fff;line-height:1;}
    #fpshop .fp-old{font-size:12px;color:var(--text-m);text-decoration:line-through;margin-left:6px;}
    #fpshop .fp-add{width:38px;height:38px;background:var(--gold);color:var(--black);border-radius:var(--r);font-size:20px;display:flex;align-items:center;justify-content:center;transition:background .15s,transform .15s;flex-shrink:0;}
    #fpshop .fp-add:hover{background:var(--gold-l);transform:scale(1.08);}
    #fpshop .fp-empty{grid-column:1/-1;text-align:center;padding:60px 20px;color:var(--text-s);}
    /* Modal */
    #fpshop .fp-modal,#fpshop .fp-drawer-bg{position:fixed;inset:0;background:rgba(0,0,0,.75);z-index:1000;display:none;opacity:0;transition:opacity .25s;}
    #fpshop .fp-modal.show,#fpshop .fp-drawer-bg.show{display:block;opacity:1;}
    #fpshop .fp-modal-in{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;padding:20px;overflow:auto;}
    #fpshop .fp-modal-box{background:var(--black2);border:1px solid var(--border);border-radius:var(--r-l);max-width:900px;width:100%;display:grid;grid-template-columns:1fr 1fr;overflow:hidden;position:relative;margin:auto;}
    #fpshop .fp-modal-img{background:#fff;display:flex;align-items:center;justify-content:center;min-height:360px;padding:24px;}
    #fpshop .fp-modal-img img{max-height:420px;object-fit:contain;}
    #fpshop .fp-modal-bd{padding:36px 32px;}
    #fpshop .fp-x{position:absolute;top:14px;right:14px;width:38px;height:38px;background:rgba(0,0,0,.5);border-radius:50%;color:#fff;font-size:20px;display:flex;align-items:center;justify-content:center;z-index:3;}
    #fpshop .fp-x:hover{background:var(--gold);color:var(--black);}
    #fpshop .fp-m-br{font-size:12px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin-bottom:8px;}
    #fpshop .fp-m-nm{font-family:"Bebas Neue",sans-serif;font-size:clamp(26px,4vw,40px);line-height:1.05;color:#fff;margin-bottom:14px;}
    #fpshop .fp-m-price{font-size:28px;font-weight:800;color:#fff;margin-bottom:16px;}
    #fpshop .fp-m-price .fp-old{font-size:16px;}
    #fpshop .fp-m-desc{font-size:14px;color:var(--text-s);line-height:1.7;margin-bottom:22px;}
    #fpshop .fp-m-lbl{font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--text-m);margin-bottom:10px;display:block;}
    #fpshop .fp-sizes{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px;}
    #fpshop .fp-size{min-width:48px;padding:9px 14px;font-size:13px;font-weight:600;color:var(--text-s);background:var(--surface);border:1px solid var(--border);border-radius:var(--r);transition:all .15s;}
    #fpshop .fp-size.on{color:var(--black);background:var(--gold);border-color:var(--gold);}
    #fpshop .fp-m-actions{display:flex;gap:12px;align-items:stretch;flex-wrap:wrap;}
    #fpshop .fp-qty{display:inline-flex;align-items:center;border:1px solid var(--border);border-radius:var(--r);background:var(--surface);overflow:hidden;}
    #fpshop .fp-qty button{width:40px;height:46px;font-size:18px;color:var(--text);}
    #fpshop .fp-qty button:hover{background:rgba(184,151,58,.12);color:var(--gold);}
    #fpshop .fp-qty span{min-width:40px;text-align:center;font-weight:700;}
    #fpshop .fp-m-add{flex:1;min-width:180px;}
    /* Drawer */
    #fpshop .fp-drawer{position:fixed;top:0;right:0;bottom:0;width:400px;max-width:92vw;background:var(--black2);border-left:1px solid var(--border);z-index:1001;transform:translateX(100%);transition:transform .3s cubic-bezier(.16,1,.3,1);display:flex;flex-direction:column;}
    #fpshop .fp-drawer.show{transform:none;}
    #fpshop .fp-drawer-hd{display:flex;align-items:center;justify-content:space-between;padding:22px 24px;border-bottom:1px solid var(--border);}
    #fpshop .fp-drawer-hd h3{font-family:"Bebas Neue",sans-serif;font-size:24px;letter-spacing:1px;}
    #fpshop .fp-drawer-items{flex:1;overflow-y:auto;padding:8px 24px;}
    #fpshop .fp-line{display:grid;grid-template-columns:64px 1fr auto;gap:14px;padding:18px 0;border-bottom:1px solid var(--border);align-items:center;}
    #fpshop .fp-line-img{background:#fff;border-radius:var(--r);aspect-ratio:1;display:flex;align-items:center;justify-content:center;padding:4px;}
    #fpshop .fp-line-br{font-size:10px;font-weight:700;letter-spacing:1px;text-transform:uppercase;color:var(--gold);}
    #fpshop .fp-line-nm{font-size:13px;font-weight:600;color:#fff;margin:2px 0;line-height:1.3;}
    #fpshop .fp-line-sz{font-size:12px;color:var(--text-m);}
    #fpshop .fp-line-r{display:flex;flex-direction:column;align-items:flex-end;gap:6px;}
    #fpshop .fp-line-qty{display:inline-flex;align-items:center;gap:2px;border:1px solid var(--border);border-radius:var(--r);}
    #fpshop .fp-line-qty button{width:26px;height:26px;font-size:15px;color:var(--text-s);}
    #fpshop .fp-line-qty span{min-width:22px;text-align:center;font-size:13px;font-weight:700;}
    #fpshop .fp-line-tot{font-size:14px;font-weight:700;}
    #fpshop .fp-line-rm{font-size:11px;color:var(--text-m);text-decoration:underline;}
    #fpshop .fp-line-rm:hover{color:#c0843a;}
    #fpshop .fp-drawer-ft{border-top:1px solid var(--border);padding:20px 24px;}
    #fpshop .fp-ship-hint{font-size:12px;color:var(--gold);margin-bottom:12px;text-align:center;}
    #fpshop .fp-sub-row{display:flex;justify-content:space-between;font-size:18px;font-weight:800;margin-bottom:14px;}
    #fpshop .fp-checkout{width:100%;}
    #fpshop .fp-drawer-empty{text-align:center;color:var(--text-s);padding:60px 20px;}
    /* Toast */
    #fpshop .fp-toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%) translateY(16px);background:var(--surface2);border:1px solid var(--border-g);color:var(--text);font-size:14px;font-weight:600;padding:13px 22px;border-radius:var(--r);box-shadow:0 16px 40px rgba(0,0,0,.5);opacity:0;pointer-events:none;transition:all .25s;z-index:1100;}
    #fpshop .fp-toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
    @media(max-width:1000px){#fpshop .fp-grid{grid-template-columns:repeat(3,1fr);}#fpshop .fp-modal-box{grid-template-columns:1fr;}#fpshop .fp-modal-img{min-height:260px;}}
    @media(max-width:680px){#fpshop .fp-grid{grid-template-columns:repeat(2,1fr);}}
    @media(max-width:400px){#fpshop .fp-grid{grid-template-columns:1fr;}}
  </style>

  <!-- Hero -->
  <section class="fp-hero">
    <div class="fp-wrap">
      <span class="fp-badge">{{ section.settings.badge | default: 'Sinds 2020 · Enschede' }}</span>
      <h1 class="fp-h1">{{ section.settings.title | default: 'FIGHTPRO' }} <span>{{ section.settings.title_accent | default: 'WINKEL' }}</span></h1>
      <p class="fp-sub">{{ section.settings.subtitle | default: 'Dé vechtsportwinkel van Twente. Alle 294 producten van topmerken als Hayabusa, Twins, Joya, Fairtex en Booster — direct online.' }}</p>
      <div class="fp-hero-btns">
        <button class="fp-btn" data-scroll>Shop nu</button>
        <button class="fp-btn fp-btn-s" data-open-cart>Winkelwagen bekijken</button>
      </div>
    </div>
  </section>

  <!-- Toolbar -->
  <div class="fp-tools" id="fpTools">
    <div class="fp-wrap fp-tools-in">
      <div class="fp-search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input type="search" id="fpSearch" placeholder="Zoek producten of merken…" aria-label="Zoeken">
      </div>
      <select class="fp-sel" id="fpBrand" aria-label="Merk"><option value="">Alle merken</option></select>
      <select class="fp-sel" id="fpSort" aria-label="Sorteren">
        <option value="feat">Aanbevolen</option>
        <option value="pl">Prijs ↑</option>
        <option value="ph">Prijs ↓</option>
        <option value="az">Naam A–Z</option>
      </select>
      <button class="fp-cart-btn" data-open-cart aria-label="Winkelwagen">
        <svg viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span class="fp-cart-count" id="fpCartCount">0</span>
      </button>
    </div>
  </div>

  <div class="fp-wrap">
    <div class="fp-chips" id="fpChips"></div>
    <p class="fp-count" id="fpResultCount"></p>
    <div class="fp-grid" id="fpGrid"></div>
  </div>

  <!-- Product modal -->
  <div class="fp-modal" id="fpModal" aria-hidden="true">
    <div class="fp-modal-in"><div class="fp-modal-box" id="fpModalBox"></div></div>
  </div>

  <!-- Cart drawer -->
  <div class="fp-drawer-bg" id="fpDrawerBg"></div>
  <aside class="fp-drawer" id="fpDrawer" aria-label="Winkelwagen">
    <div class="fp-drawer-hd">
      <h3>Winkelwagen</h3>
      <button class="fp-x" style="position:static" data-close-cart aria-label="Sluiten">×</button>
    </div>
    <div class="fp-drawer-items" id="fpDrawerItems"></div>
    <div class="fp-drawer-ft" id="fpDrawerFt"></div>
  </aside>

  <div class="fp-toast" id="fpToast"></div>

