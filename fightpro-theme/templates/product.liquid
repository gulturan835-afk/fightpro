<div class="shop-head" style="padding-bottom:0;border-bottom:none;">
  <div class="container">
    <nav class="crumb">
      <a href="{{ routes.root_url }}">Home</a> <span>/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title }}</a> <span>/</span>
      {%- endif -%}
      <span class="cur">{{ product.title }}</span>
    </nav>
  </div>
</div>

<section class="sec" style="background:var(--black2);padding-top:28px;">
  <div class="container">
    <div class="pd-g">
      <div class="pd-sticky">
        <div class="pd-media">
          {%- if product.compare_at_price > product.price -%}
            <span class="bdg bo pd-badge">Aanbieding</span>
          {%- endif -%}
          {%- if product.featured_image != blank -%}
            {{ product.featured_image | image_url: width: 1000 | image_tag: alt: product.title, width: 800, height: 800 }}
          {%- else -%}
            {% render 'product-media', product: product, size: 320 %}
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="pd-thumbs">
            {%- for image in product.images limit: 6 -%}
              <button type="button" class="pd-thumb {% if forloop.first %}on{% endif %}" data-src="{{ image | image_url: width: 1000 }}" aria-label="Foto {{ forloop.index }}">
                {{ image | image_url: width: 152 | image_tag: loading: 'lazy', width: 76, height: 76, alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pd-info">
        <div class="pd-brand">{{ product.vendor }}</div>
        <h1 class="pd-name">{{ product.title }}</h1>
        <div class="pd-price-row">
          <span class="pd-price">{{ product.price | money }}</span>
          {%- if product.compare_at_price > product.price -%}
            <span class="pd-old">{{ product.compare_at_price | money }}</span>
            {%- assign saved = product.compare_at_price | minus: product.price -%}
            <span class="pd-save">Bespaar {{ saved | money }}</span>
          {%- endif -%}
        </div>
        <div class="pd-desc">{{ product.description }}</div>

        <form class="pd-form js-add-form" action="{{ routes.cart_add_url }}" method="post" data-name="{{ product.vendor }} {{ product.title | escape }}">
          {%- if product.variants.size > 1 -%}
            <div class="pd-field">
              <label class="pd-label">{{ product.options.first | default: 'Maat' }}</label>
              <div class="size-row">
                {%- for variant in product.variants -%}
                  <label class="size-opt">
                    <input type="radio" name="id" value="{{ variant.id }}" {% if forloop.first %}checked{% endif %} {% unless variant.available %}disabled{% endunless %}>
                    <span>{{ variant.title }}</span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          {%- endif -%}

          <div class="pd-actions">
            <div class="qty-box">
              <button type="button" class="qty-btn js-qty-minus" aria-label="Minder">−</button>
              <input type="number" name="quantity" class="qty-input" value="1" min="1" aria-label="Aantal">
              <button type="button" class="qty-btn js-qty-plus" aria-label="Meer">+</button>
            </div>
            <button type="submit" class="btn-p btn-lg pd-add" {% unless product.available %}disabled{% endunless %}>
              {%- if product.available -%}In winkelwagen →{%- else -%}Uitverkocht{%- endif -%}
            </button>
          </div>
          <p class="pd-stock">
            {%- if product.available -%}
              <span class="dot-ok"></span> Op voorraad — vandaag te passen in de winkel
            {%- else -%}
              <span class="dot-no"></span> Op aanvraag — bel of mail ons
            {%- endif -%}
          </p>
        </form>
      </div>
    </div>
  </div>
</section>

{%- if collection and collection.products.size > 1 -%}
<section class="sec" style="background:var(--black);">
  <div class="container">
    <div class="p-hd"><div><div class="lbl">Misschien ook interessant</div><h2 class="ttl">Vergelijkbare <span class="ac">producten</span></h2></div></div>
    <div class="pg">
      {%- assign shown = 0 -%}
      {%- for p in collection.products -%}
        {%- if p.id != product.id and shown < 4 -%}
          {% render 'product-card', product: p %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}
