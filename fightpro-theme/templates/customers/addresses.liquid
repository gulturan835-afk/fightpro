<div class="shop-head">
  <div class="container">
    <nav class="crumb"><a href="{{ routes.root_url }}">Home</a> <span>/</span> <a href="{{ routes.account_url }}">Mijn account</a> <span>/</span> <span class="cur">Adressen</span></nav>
    <h1 class="shop-title">Adressen</h1>
  </div>
</div>

<section class="sec" style="background:var(--black);padding-top:36px;">
  <div class="container" style="max-width:640px;">
    {%- for address in customer.addresses -%}
      <div class="cart-line">
        <div class="cart-mid">
          {%- if address == customer.default_address -%}<div class="cart-brand">Standaard</div>{%- endif -%}
          <span class="cart-name">{{ address.first_name }} {{ address.last_name }}</span>
          <div class="cart-unit">{{ address.address1 }}{% if address.address2 != blank %}, {{ address.address2 }}{% endif %} · {{ address.zip }} {{ address.city }}</div>
        </div>
      </div>
    {%- else -%}
      <p class="empty-msg">Nog geen adressen opgeslagen.</p>
    {%- endfor -%}

    <h2 class="sum-title" style="margin-top:36px;">Nieuw adres</h2>
    {% form 'customer_address', customer.new_address %}
      <div class="co-row">
        <div class="co-field"><label>Voornaam</label><input type="text" name="address[first_name]" autocomplete="given-name"></div>
        <div class="co-field"><label>Achternaam</label><input type="text" name="address[last_name]" autocomplete="family-name"></div>
      </div>
      <div class="co-field"><label>Adres</label><input type="text" name="address[address1]" autocomplete="address-line1"></div>
      <div class="co-row">
        <div class="co-field" style="max-width:160px;"><label>Postcode</label><input type="text" name="address[zip]" autocomplete="postal-code"></div>
        <div class="co-field"><label>Plaats</label><input type="text" name="address[city]" autocomplete="address-level2"></div>
      </div>
      <div class="co-field"><label>Land</label><input type="text" name="address[country]" value="Netherlands" autocomplete="country-name"></div>
      <button type="submit" class="btn-p" style="width:100%;justify-content:center;">Adres opslaan</button>
    {% endform %}
  </div>
</section>
