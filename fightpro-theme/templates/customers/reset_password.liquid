<section class="sec" style="background:var(--black);min-height:60vh;">
  <div class="container" style="max-width:480px;">
    <div class="lbl">Account</div>
    <h1 class="ttl" style="margin-bottom:28px;">Nieuw wachtwoord</h1>
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <div class="co-field">
        <label for="ResetPassword">Nieuw wachtwoord</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="co-field">
        <label for="ResetPasswordConfirm">Wachtwoord bevestigen</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="btn-p btn-lg" style="width:100%;justify-content:center;">Wachtwoord opslaan →</button>
    {% endform %}
  </div>
</section>
