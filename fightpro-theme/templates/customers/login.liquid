<section class="sec" style="background:var(--black);min-height:60vh;">
  <div class="container" style="max-width:480px;">
    <div class="lbl">Account</div>
    <h1 class="ttl" style="margin-bottom:28px;">Inloggen</h1>
    {% form 'customer_login', novalidate: 'novalidate' %}
      {{ form.errors | default_errors }}
      <div class="co-field">
        <label for="CustomerEmail">E-mail</label>
        <input type="email" id="CustomerEmail" name="customer[email]" autocomplete="email" required>
      </div>
      <div class="co-field">
        <label for="CustomerPassword">Wachtwoord</label>
        <input type="password" id="CustomerPassword" name="customer[password]" autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn-p btn-lg" style="width:100%;justify-content:center;">Inloggen →</button>
      <p style="margin-top:18px;font-size:13.5px;color:var(--text-s);">
        <a href="#recover" style="color:var(--gold);">Wachtwoord vergeten?</a> ·
        <a href="{{ routes.account_register_url }}" style="color:var(--gold);">Account aanmaken</a>
      </p>
    {% endform %}

    <div id="recover" style="margin-top:44px;">
      <h2 class="sum-title">Wachtwoord herstellen</h2>
      {% form 'recover_customer_password' %}
        {{ form.errors | default_errors }}
        {%- if form.posted_successfully? -%}
          <p class="sum-hint">We hebben je een e-mail gestuurd om je wachtwoord te herstellen.</p>
        {%- endif -%}
        <div class="co-field">
          <label for="RecoverEmail">E-mail</label>
          <input type="email" id="RecoverEmail" name="email" autocomplete="email" required>
        </div>
        <button type="submit" class="btn-s" style="width:100%;justify-content:center;">Verstuur herstel-link</button>
      {% endform %}
    </div>
  </div>
</section>
