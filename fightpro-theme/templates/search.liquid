<div class="shop-head">
  <div class="container">
    <nav class="crumb"><a href="{{ routes.root_url }}">Home</a> <span>/</span> <span class="cur">Zoeken</span></nav>
    <h1 class="shop-title">Zoekresultaten</h1>
    {%- if search.performed -%}
      <p class="shop-blurb">{{ search.results_count }} resulta{% if search.results_count == 1 %}at{% else %}ten{% endif %} voor “{{ search.terms | escape }}”</p>
    {%- endif -%}
  </div>
</div>

<section class="sec" style="background:var(--black);padding-top:36px;">
  <div class="container">
    {%- unless search.performed -%}
      <p class="empty-msg">Typ iets in de zoekbalk om producten te vinden.</p>
    {%- else -%}
      {%- if search.results_count == 0 -%}
        <p class="empty-msg">Geen producten gevonden voor “{{ search.terms | escape }}”.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn-p btn-lg" style="margin-top:8px;">Bekijk de collectie →</a>
      {%- else -%}
        {%- paginate search.results by 24 -%}
          <div class="pg">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <div class="filter-row" style="justify-content:center;margin-top:44px;">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="chip">← Vorige</a>{%- endif -%}
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="chip">Volgende →</a>{%- endif -%}
            </div>
          {%- endif -%}
        {%- endpaginate -%}
      {%- endif -%}
    {%- endunless -%}
  </div>
</section>
