{%- comment -%}
  Renders a branded SVG illustration as a fallback when a product has no image.
  Params: kind (glove|shield|wrap|bag|rope|apparel), body (hex), cuff (hex), brand, size
{%- endcomment -%}
{%- assign art_kind = kind | default: 'glove' -%}
{%- assign art_body = body | default: '#1A1A1A' -%}
{%- assign art_cuff = cuff | default: '#B8973A' -%}
{%- assign art_size = size | default: 140 -%}
{%- assign art_label = brand | default: '' | upcase | slice: 0, 9 -%}
<svg width="{{ art_size }}" height="{{ art_size }}" viewBox="0 0 140 140" fill="none" role="img" aria-label="{{ brand }} {{ name | escape }}">
  <ellipse cx="70" cy="130" rx="50" ry="7" fill="rgba(0,0,0,.45)"/>
  {%- case art_kind -%}
    {%- when 'shield' -%}
      <rect x="30" y="40" width="80" height="74" rx="10" fill="#141414" stroke="rgba(184,151,58,.3)" stroke-width="1"/>
      <path d="M47 102C47 80 56 62 70 62C84 62 93 80 93 102" fill="{{ art_body }}" opacity=".85"/>
      <rect x="30" y="40" width="80" height="16" rx="8" fill="{{ art_cuff }}" opacity=".85"/>
    {%- when 'wrap' -%}
      <rect x="34" y="50" width="72" height="56" rx="8" fill="#141414" stroke="rgba(184,151,58,.3)" stroke-width="1"/>
      <rect x="34" y="50" width="72" height="16" rx="6" fill="{{ art_cuff }}" opacity=".8"/>
      <circle cx="70" cy="86" r="14" fill="{{ art_body }}" opacity=".7"/>
    {%- when 'bag' -%}
      <rect x="50" y="20" width="40" height="92" rx="14" fill="{{ art_body }}"/>
      <rect x="50" y="20" width="40" height="14" rx="7" fill="{{ art_cuff }}"/>
      <rect x="50" y="100" width="40" height="12" rx="6" fill="#111"/>
    {%- when 'rope' -%}
      <rect x="40" y="40" width="10" height="40" rx="5" fill="{{ art_cuff }}"/>
      <rect x="90" y="40" width="10" height="40" rx="5" fill="{{ art_cuff }}"/>
      <path d="M45 80 C 45 130, 95 130, 95 80" stroke="{{ art_body }}" stroke-width="4" fill="none"/>
    {%- when 'apparel' -%}
      <path d="M45 45 L60 35 L80 35 L95 45 L88 60 L82 56 L82 110 L58 110 L58 56 L52 60 Z" fill="{{ art_body }}"/>
      <path d="M45 45 L60 35 L80 35 L95 45" stroke="{{ art_cuff }}" stroke-width="3" fill="none"/>
    {%- else -%}
      <rect x="38" y="96" width="64" height="28" rx="5" fill="#111"/>
      <rect x="38" y="96" width="64" height="11" rx="4" fill="{{ art_cuff }}"/>
      <path d="M40 57C33 41 31 25 37 14C44 2 56-1 65 2C70 4 70 11 70 11C70 11 70 4 75 2C84-1 96 2 103 14C109 25 107 41 100 57L96 97H44Z" fill="{{ art_body }}"/>
      <ellipse cx="54" cy="18" rx="10" ry="7" fill="{{ art_cuff }}"/>
      <ellipse cx="69" cy="11" rx="11" ry="8" fill="{{ art_cuff }}"/>
      <ellipse cx="85" cy="11" rx="11" ry="8" fill="{{ art_cuff }}"/>
      <ellipse cx="99" cy="18" rx="10" ry="7" fill="{{ art_cuff }}"/>
  {%- endcase -%}
  {%- if art_label != blank -%}
    <text x="70" y="80" font-family="Arial" font-size="8" fill="rgba(184,151,58,.55)" text-anchor="middle" letter-spacing="2">{{ art_label }}</text>
  {%- endif -%}
</svg>
