<footer>
<div class="f-bar"></div>
<div class="f-top">
<div>
  <img class="f-logo" src="/img/logo.png" alt="FightPro Enschede" width="144" height="46">
  <p class="f-desc">Dé vechtsportwinkel van Twente. Officiële dealer van <%= brands.length %> topmerken — van Joya en Hayabusa tot Twins en Fairtex. Geopend in 2020 in Enschede.</p>
  <div class="f-soc-r"><a class="f-soc" href="#" aria-label="Facebook">FB</a><a class="f-soc" href="#" aria-label="Instagram">IG</a><a class="f-soc" href="#" aria-label="YouTube">YT</a></div>
  <div class="pay-r"><span class="pay">iDEAL</span><span class="pay">VISA</span><span class="pay">MC</span><span class="pay">PAYPAL</span></div>
</div>
<div><div class="f-ct">Shop</div><ul class="f-ls">
  <% navGroups.forEach(function(g){ %>
    <li><a href="/categorie/<%= g.slug %>"><%= g.name %></a></li>
  <% }) %>
  <% navSingles.forEach(function(c){ %>
    <li><a href="/categorie/<%= c.slug %>"><%= c.name %></a></li>
  <% }) %>
</ul></div>
<div><div class="f-ct">Merken (<%= brands.length %>)</div><ul class="f-ls f-cols">
  <% brands.forEach(function(b){ %>
    <li><a href="/zoeken?q=<%= encodeURIComponent(b) %>"><%= b %></a></li>
  <% }) %>
</ul></div>
<div><div class="f-ct">Informatie</div><ul class="f-ls">
  <li><a href="/#over-ons">Over ons</a></li>
  <li><a href="/#groothandel">Groothandel</a></li>
  <li><a href="/#contact">Openingstijden</a></li>
  <li><a href="/#contact">Contact</a></li>
  <li><a href="#">Privacybeleid</a></li>
  <li><a href="#">Algemene voorwaarden</a></li>
</ul></div>
</div>
<div class="f-bot"><div class="f-bot-in"><p class="f-cp">© <%= new Date().getFullYear() %> <span>FightPro Enschede</span> — by FP Fight Gear®. Alle rechten voorbehouden.</p><div class="f-lg"><a href="#">Privacy</a><a href="#">Voorwaarden</a><a href="#">Cookies</a></div></div></div>
</footer>

<% if (locals.includeIntro) { %>
<script src="/vendor/three.min.js"></script>
<script src="/vendor/gsap.min.js"></script>
<script src="/vendor/ScrollTrigger.min.js"></script>
<script src="/js/intro.js"></script>
<% } %>
<script src="/js/main.js"></script>
</body>
</html>
